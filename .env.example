# Copy to .env for local development. Never commit the real .env.
# On Vercel these are set under Settings -> Environment Variables instead.

# Required. Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Optional. Where consultation requests are delivered.
# Defaults to parisheducationalconsultingllc@gmail.com
# CONTACT_TO_EMAIL=parisheducationalconsultingllc@gmail.com

# Optional. The From address. Must be on a domain verified in Resend.
# Defaults to onboarding@resend.dev, which only delivers to the
# Resend account owner's own address.
# CONTACT_FROM_EMAIL=website@parisheducationalconsulting.net
